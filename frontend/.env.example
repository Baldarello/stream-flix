# TMDB API Key (JWT token)
API_KEY="your-api-key-here"

# Google OAuth Client ID
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# WebSocket URL for backend server
VITE_WS_URL=ws://localhost:3011/ws

# Google Apps Script URL for analytics
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# TURN server configuration for WebRTC
TND_TURN_URL=[{"urls":"stun:turn.example.com:3478"},{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"],"username":"your-username","credential":"your-credential"},{"urls":"turns:turn.example.com:5349?transport=tcp","username":"your-username","credential":"your-credential"}]
