{
    "name": "quix",
    "private": true,
    "version": "1.0.0",
    "description": "Quix - Video streaming with watch together functionality",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint . --config eslint.config.js",
        "lint:fix": "eslint . --config eslint.config.js --fix",
        "format": "prettier --config .prettierrc.json --write \"**/*.{js,jsx,json,md,yml,yaml}\"",
        "format:check": "prettier --config .prettierrc.json --check \"**/*.{js,jsx,json,md,yml,yaml}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "e2e": "playwright test",
        "e2e:install": "playwright install --with-deps chromium",
        "prepare": "cd .. && husky frontend/.husky/pre-commit || true"
    },
    "dependencies": {
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@mui/icons-material": "7.3.11",
        "@mui/material": "7.3.11",
        "axios": "1.18.1",
        "dexie": "4.4.4",
        "gsap": "3.15.0",
        "html5-qrcode": "2.3.8",
        "mobx": "6.16.1",
        "mobx-react-lite": "4.1.1",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "react-router": "7.13.1",
        "three": "0.184.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.12.1",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.61.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@vitejs/plugin-react": "6.0.3",
        "@vitest/coverage-v8": "4.1.9",
        "axe-core": "4.12.1",
        "eslint": "10.5.0",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.3",
        "globals": "17.7.0",
        "husky": "9.1.7",
        "jsdom": "29.1.1",
        "lint-staged": "17.0.8",
        "prettier": "3.8.4",
        "vite": "8.1.0",
        "vitest": "4.1.9"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
