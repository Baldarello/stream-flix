# MiniMax API key (required for minimax model in opencode)
MINIMAX_API_KEY=

# OpenCode API key (only if using OpenCode's own models)
OPENCODE_API_KEY=

# GitHub personal access token — for GitHub Issues issue tracker
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Issues (Read and write) and Metadata (Read)
GH_TOKEN=
